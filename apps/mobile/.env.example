# Copy to .env. Everything here is embedded in the app bundle and is therefore PUBLIC.
# NEVER put an API key, token or secret in an EXPO_PUBLIC_* variable.

# Origin of your deployed NutriScan Worker (no trailing path). Leave empty for fully local mode.
# Example: https://nutriscan-api.your-subdomain.workers.dev
EXPO_PUBLIC_API_BASE_URL=

# Contact shown in the User-Agent sent to Open Food Facts (use a monitored email).
EXPO_PUBLIC_OFF_CONTACT=
