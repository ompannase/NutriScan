  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
